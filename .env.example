# TeleCore backend configuration — copy to .env and fill in.
# NEVER commit a real .env or real tokens/secrets to source control.

# Bind address and port for the Axum server
TELECORE_HOST=127.0.0.1
TELECORE_PORT=8080

# SQLite database file path
DATABASE_URL=sqlite:telecore.db

# API key required in the X-API-Key header for all /api/* routes except /api/health.
# Generate a strong random value, e.g. `openssl rand -hex 32`.
TELECORE_API_KEY=change-me-to-a-strong-random-api-key

# 32-byte encryption key for bot tokens (AES-256-GCM), hex (64 chars) or base64 (44 chars).
# Generate with: openssl rand -hex 32
# If unset, the server generates one on first run and stores it in telecore.key (mode 0600).
TELECORE_ENCRYPTION_KEY=

# Log level: error, warn, info, debug, trace
RUST_LOG=info
